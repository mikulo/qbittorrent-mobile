<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/qb_blue" android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar" app:title="@string/settings" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/speed_limits" android:textColor="@color/qb_blue" android:textStyle="bold" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/download_limit" app:boxBackgroundMode="outline"><com.google.android.material.textfield.TextInputEditText android:id="@+id/download_limit" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" /></com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/upload_limit" app:boxBackgroundMode="outline"><com.google.android.material.textfield.TextInputEditText android:id="@+id/upload_limit" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" /></com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/connection_settings" android:textColor="@color/qb_blue" android:textStyle="bold" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/listen_port" app:boxBackgroundMode="outline"><com.google.android.material.textfield.TextInputEditText android:id="@+id/listen_port" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" /></com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/enable_dht" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/enable_dht" />
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/enable_lsd" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/enable_lsd" />
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/enable_upnp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/enable_upnp" />
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/enable_natpmp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/enable_natpmp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/proxy_settings" android:textColor="@color/qb_blue" android:textStyle="bold" />
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/proxy_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/proxy_enable_socks5" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/proxy_host" app:boxBackgroundMode="outline"><com.google.android.material.textfield.TextInputEditText android:id="@+id/proxy_host" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" /></com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/proxy_port" app:boxBackgroundMode="outline"><com.google.android.material.textfield.TextInputEditText android:id="@+id/proxy_port" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" /></com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/proxy_hostnames" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/proxy_hostnames" />
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/proxy_peer_connections" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/proxy_peer_connections" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/proxy_address_hint" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/https_tracker_android_warning" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/protocol_identity" android:textColor="@color/qb_blue" android:textStyle="bold" />
            <TextView android:id="@+id/protocol_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="4dp" android:text="@string/protocol_identity_summary" android:textIsSelectable="true" />
            <TextView android:id="@+id/download_path" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textIsSelectable="true" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/choose_download_path" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/choose_download_path" />
                <com.google.android.material.button.MaterialButton android:id="@+id/reset_download_path" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/reset_download_path" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/save" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/process_diagnostics" android:textStyle="bold" />
            <TextView android:id="@+id/log_path" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textIsSelectable="true" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/choose_log_path" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/choose_log_path" />
                <com.google.android.material.button.MaterialButton android:id="@+id/reset_log_path" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reset_download_path" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/log_retention_hint" android:textSize="12sp" />
            <TextView android:id="@+id/process_diagnostics" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textIsSelectable="true" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
